{
  "name": "contacts-api",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "dist/app/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/app/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:ci": "jest --coverage --runInBand",
    "migrate": "prisma migrate deploy",
    "migrate:test": "node scripts/migrate-test.js",
    "migrate:generate": "prisma generate"
  },
  "keywords": [],
  "author": "RissDevSec", 
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.0.0",
    "jest": "^30.0.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": ">3.23.0",
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
