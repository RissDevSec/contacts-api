# Copy to .env and fill in real values. Never commit .env.

# MySQL connection string used by Prisma.
DATABASE_URL="mysql://root:your-password@localhost:3306/contacts"

# Redis connection string (database index 0 is used by default).
REDIS_URL="redis://localhost:6379/0"

# Secrets. Use long random values, for example: openssl rand -hex 32
SECRET_KEY="change-me"            # signs access tokens
SECRET_KEY_DATABASE="change-me-2" # signs refresh tokens
SECRET_KEY_COOKIE="change-me-3"   # signs the refresh token cookie

# Optional
PORT=3000
